# Request resources
request_gpus   = 1
request_cpus   = 1
request_memory = 16GB

# Files
executable = scripts/train_custom.sh
output     = batchSubmissions/train_custom_$(Cluster)_$(Process)_$(UnixTime).out
error      = batchSubmissions/train_custom_$(Cluster)_$(Process)_$(UnixTime).err
log        = batchSubmissions/train_custom_$(Cluster)_$(UnixTime).log

# Queue job
queue