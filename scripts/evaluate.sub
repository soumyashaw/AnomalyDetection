# Request resources
request_gpus   = 1
request_cpus   = 2
request_memory = 16GB

# Files
executable = scripts/evaluate.sh
output     = batchSubmissions/evaluate_$(Cluster)_$(Process)_$(UnixTime).out
error      = batchSubmissions/evaluate_$(Cluster)_$(Process)_$(UnixTime).err
log        = batchSubmissions/evaluate_$(Cluster)_$(UnixTime).log

# Queue job
queue
