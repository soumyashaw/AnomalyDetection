#!/bin/bash
#SBATCH --job-name=evaluate
#SBATCH --partition=c23g
#SBATCH --time=04:00:00
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=2
#SBATCH --mem=16G
#SBATCH --gres=gpu:1
#SBATCH --output=batchSubmissions/evaluate_%j.out
#SBATCH --error=batchSubmissions/evaluate_%j.err

set -euo pipefail
mkdir -p batchSubmissions

bash scripts/evaluate.sh
